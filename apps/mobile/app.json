{
  "expo": {
    "name": "LuggageShare",
    "slug": "luggageshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luggageshare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C6AFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luggageshare.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LuggageShare needs camera access to take photos of items",
        "NSPhotoLibraryUsageDescription": "LuggageShare needs photo library access to upload item photos",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#7C6AFF"
      },
      "package": "com.luggageshare.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LuggageShare uses your location to set the pickup meeting point on the map.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LuggageShare to access your photos to upload item images.",
          "cameraPermission": "Allow LuggageShare to use your camera to take photos of items.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#7C6AFF"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "./plugins/withAndroidDialogTheme"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "144efabf-b267-46fe-9609-8147fcd00585"
      },
      "apiUrl": "https://luggageshare-api.vercel.app",
      "supabaseUrl": "https://gbdhlolfyycabpjoqhan.supabase.co",
      "supabasePublishableKey": "sb_publishable_IJg01FKuDoOraYCEpXA6ag_1XlB-0gu",
      "googleWebClientId": "74009374313-rak28eramgaojnr67fivn8qqo9hjin6r.apps.googleusercontent.com",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "webUrl": "https://luggageshare-iota.vercel.app"
    },
    "owner": "aimanqaid",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/144efabf-b267-46fe-9609-8147fcd00585"
    }
  }
}
