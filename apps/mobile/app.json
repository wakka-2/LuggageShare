{
  "expo": {
    "name": "LuggageShare",
    "slug": "luggageshare",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luggageshare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E5A8F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luggageshare.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LuggageShare needs camera access to take photos of items",
        "NSPhotoLibraryUsageDescription": "LuggageShare needs photo library access to upload item photos",
        "NSLocationWhenInUseUsageDescription": "LuggageShare needs location access for pickup and delivery coordination"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2E5A8F"
      },
      "package": "com.luggageshare.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LuggageShare to access your camera to take photos of items."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LuggageShare to access your photos to upload item images."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LuggageShare to use your location for pickup and delivery coordination."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2E5A8F"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    }
  }
}
