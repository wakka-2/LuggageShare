{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && printf 'LuggageShare API' > public/index.html",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/v1/cron/offers-expiry",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
