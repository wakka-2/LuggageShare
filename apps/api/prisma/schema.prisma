generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// User & Authentication
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  avatarUrl     String?
  phone         String?
  bio           String?
  city          String?
  isVerified    Boolean   @default(false)
  tosAcceptedAt DateTime?
  iban          String?
  bankName      String?
  googleId      String?   @unique
  appleId       String?   @unique
  provider      String    // 'google' | 'apple'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  settings        UserSettings?
  carrierListings Listing[]       @relation("CarrierListings")
  flights         Flight[]        @relation("UserFlights")
  offers          Offer[]         @relation("UserOffers")
  senderBookings  Booking[]       @relation("SenderBookings")
  carrierBookings Booking[]       @relation("CarrierBookings")
  messages        Message[]
  reviews         Review[]        @relation("ReviewAuthor")
  receivedReviews Review[]        @relation("ReviewReceiver")
  disputes        Dispute[]       @relation("DisputeReporter")
  notifications   Notification[]
  pushTokens      PushToken[]
  balanceHistory  BalanceHistory[]
  refreshTokens   RefreshToken[]

  @@map("users")
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  language      String   @default("ar")
  currency      String   @default("SAR")
  notifications Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ==========================================
// Listings
// ==========================================

model Listing {
  id              String   @id @default(cuid())
  carrierId       String
  departureCity   String
  departureCode   String?
  arrivalCity     String
  arrivalCode     String?
  departureDate   DateTime
  flightNumber    String?
  availableWeight Decimal  @db.Decimal(5, 2)
  price           Decimal  @db.Decimal(8, 2) @map("pricePerKg")
  currency        String   @default("SAR")
  preferences     Json?
  notes           String?
  status          String   @default("active") // active, completed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  carrier  User      @relation("CarrierListings", fields: [carrierId], references: [id])
  bookings Booking[]

  @@index([departureCity, arrivalCity, departureDate])
  @@index([carrierId])
  @@map("listings")
}

// ==========================================
// Flights & Offers (New business model)
// ==========================================

model Flight {
  id              String   @id @default(cuid())
  posterId        String
  departureCity   String
  departureCode   String?
  arrivalCity     String
  arrivalCode     String?
  departureDate   DateTime
  flightNumber    String?
  availableWeight Decimal  @db.Decimal(5, 2)
  remainingWeight Decimal  @db.Decimal(5, 2)
  suggestedPrice  Decimal? @db.Decimal(8, 2)
  currency        String   @default("SAR")
  notes           String?
  status          String   @default("active") // active, full, completed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  poster   User      @relation("UserFlights", fields: [posterId], references: [id])
  offers   Offer[]
  bookings Booking[] @relation("FlightBookings")

  @@index([departureCity, arrivalCity, departureDate])
  @@index([posterId])
  @@map("flights")
}

model Offer {
  id            String   @id @default(cuid())
  flightId      String
  senderId      String
  offeredWeight Decimal  @db.Decimal(5, 2)
  offeredPrice  Decimal  @db.Decimal(10, 2)
  currency      String   @default("SAR")
  status        String   @default("pending") // pending, accepted, rejected, expired, withdrawn
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  flight   Flight    @relation(fields: [flightId], references: [id], onDelete: Cascade)
  sender   User      @relation("UserOffers", fields: [senderId], references: [id])
  booking  Booking?  @relation("OfferBooking")
  messages Message[] @relation("OfferMessages")

  @@index([flightId])
  @@index([senderId])
  @@map("offers")
}

// ==========================================
// Bookings & Items
// ==========================================

model Booking {
  id          String    @id @default(cuid())
  listingId   String?   // nullable: legacy listings; new bookings use flightId
  offerId     String?   @unique // set when booking is created from an accepted offer
  flightId    String?   // denormalized for fast queries
  senderId    String
  carrierId   String
  status          String    @default("pending") // pending, accepted, rejected, picked_up, in_transit, delivered, cancelled
  totalWeight     Decimal   @db.Decimal(5, 2)
  totalPrice      Decimal   @db.Decimal(10, 2)
  currency        String    @default("SAR")
  paymentProofUrl String?
  paymentStatus   String    @default("unpaid") // unpaid, proof_submitted, confirmed, failed
  cancelledBy     String?
  cancelledAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  listing  Listing?  @relation(fields: [listingId], references: [id])
  offer    Offer?    @relation("OfferBooking", fields: [offerId], references: [id])
  flight   Flight?   @relation("FlightBookings", fields: [flightId], references: [id])
  sender   User      @relation("SenderBookings", fields: [senderId], references: [id])
  carrier  User      @relation("CarrierBookings", fields: [carrierId], references: [id])
  items    Item[]
  messages Message[]
  review   Review?
  dispute  Dispute?

  @@index([senderId])
  @@index([carrierId])
  @@index([listingId])
  @@index([flightId])
  @@map("bookings")
}

model Item {
  id          String   @id @default(cuid())
  bookingId   String
  name        String
  description String?
  weight      Decimal  @db.Decimal(5, 2)
  value       Decimal  @db.Decimal(10, 2)
  currency    String   @default("SAR")
  imageUrls   String[]
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("items")
}

// ==========================================
// Messaging
// ==========================================

model Message {
  id        String   @id @default(cuid())
  bookingId String?  // nullable: pre-booking offer messages have no bookingId yet
  offerId   String?  // set for pre-booking negotiation chat; cleared after offer → booking
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  offer   Offer?   @relation("OfferMessages", fields: [offerId], references: [id], onDelete: Cascade)
  sender  User     @relation(fields: [senderId], references: [id])

  @@index([bookingId, createdAt])
  @@index([offerId, createdAt])
  @@map("messages")
}

// ==========================================
// Reviews
// ==========================================

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  reviewerId String
  revieweeId String
  rating     Int      // 1-5
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("ReviewAuthor", fields: [reviewerId], references: [id])
  reviewee User    @relation("ReviewReceiver", fields: [revieweeId], references: [id])

  @@index([revieweeId])
  @@map("reviews")
}

// ==========================================
// Disputes
// ==========================================

model Dispute {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  reporterId  String
  reason      String
  description String?
  status      String   @default("open") // open, investigating, resolved, dismissed
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  reporter User    @relation("DisputeReporter", fields: [reporterId], references: [id])

  @@index([reporterId])
  @@map("disputes")
}

// ==========================================
// Notifications
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   // ios, android, web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("push_tokens")
}

// ==========================================
// Refresh Tokens (Rotation + Revocation)
// ==========================================

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  family    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ==========================================
// Balance (Phase 2)
// ==========================================

model BalanceHistory {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  type        String   // commission, top_up, refund
  description String?
  bookingId   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("balance_history")
}
